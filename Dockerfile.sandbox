# syntax=docker/dockerfile:1.7

FROM gcr.io/distroless/nodejs24-debian13:nonroot@sha256:af85d11ce7ef10172855a6e3649e3e8125b1b9e3ca41849ec2918036f05cb212 AS sandbox-api
ARG VCS_REF=unknown
LABEL org.opencontainers.image.revision=$VCS_REF
ENV NODE_ENV=production PATH=/nodejs/bin:$PATH
WORKDIR /app
ENTRYPOINT []
COPY --chown=10001:10001 sandbox-api/ /app/
COPY --chown=10001:10001 sandbox-migrations/ /app/sandbox-migrations/
USER 10001:10001
EXPOSE 3001
HEALTHCHECK --interval=5s --timeout=3s --start-period=10s --retries=12 \
  CMD ["node", "--input-type=module", "--eval", "const r=await fetch('http://127.0.0.1:3001/health/ready');if(!r.ok)process.exit(1)"]
CMD ["node", "dist/server.js"]
