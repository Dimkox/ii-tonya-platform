{
  "name": "@ii-tonya/sandbox-api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "files": [
    "dist"
  ],
  "main": "dist/server.js",
  "types": "dist/server.d.ts",
  "exports": {
    ".": {
      "types": "./dist/server.d.ts",
      "import": "./dist/server.js"
    }
  },
  "scripts": {
    "build": "tsup src/server.ts --format esm --dts --clean --tsconfig ../../tsconfig.base.json",
    "typecheck": "tsc --noEmit -p ../../tsconfig.base.json"
  },
  "dependencies": {
    "@ii-tonya/api": "workspace:*",
    "@ii-tonya/db": "workspace:*",
    "@ii-tonya/sandbox-payments": "workspace:*",
    "fastify": "^5.5.0"
  }
}
