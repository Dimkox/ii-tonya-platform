# Authenticated MFA manager verification; payment transports remain separate.
EXPERT_VERIFICATION_ENABLED=false
EXPERT_VERIFICATION_PAYMENT_MODE=
EXPERT_VERIFICATION_MESSAGING_CONSENT_POLICY_VERSION=
