# Runtime
NODE_ENV=development
HOST=127.0.0.1
PORT=3000
DATABASE_URL=postgres://ii_tonya:__PLACEHOLDER_DB_PASSWORD__@127.0.0.1:5432/ii_tonya
ALLOW_INSECURE_LOCAL_DATABASE=true
DISPLAY_TIMEZONE=Europe/Moscow
RAW_CONVERSATION_LOGGING=false
MINOR_ONBOARDING_ENABLED=false
EXPERT_REFERRAL_ENABLED=false
EXPERT_RESIDENCY_BILLING_ENABLED=false
EXPERT_TELEGRAM_QUERIES_ENABLED=false
EXPERT_TELEGRAM_FINANCIAL_VIEWS_ENABLED=false
EXPERT_AI_INGRESS_ENABLED=false
EXPERT_TELEGRAM_REFERRAL_ENABLED=false
EXPERT_TELEGRAM_CHECKOUT_ENABLED=false
WORKER_OUTBOX_DELIVERY_ENABLED=false
CLIENT_SESSION_ENABLED=false
CLIENT_SESSION_BOOKING_GRANTS_ENABLED=false
CLIENT_CATALOG_ENABLED=false
CLIENT_BOOKING_ENABLED=false
CLIENT_BOOKING_RESERVE_ENABLED=false
CLIENT_PRIVACY_ENABLED=false
CLIENT_ERASURE_REQUESTS_ENABLED=false
TELEGRAM_EGRESS_CONSENT_GATE_ENABLED=false
CLIENT_BOOKING_CONFIRMATION_BUFFER_MINUTES=60
EXPERT_REFERRAL_HMAC_KEY_VERSION=__PLACEHOLDER_KEY_VERSION__
EXPERT_REFERRAL_HMAC_KEY_REF=__PLACEHOLDER_ENV_SECRET_REFERENCE__
EXPERT_REFERRAL_HMAC_KEYS_JSON=__PLACEHOLDER_SECRET_MANAGER_VALUE__

# All external integrations fail closed until their staging contracts pass.
SELARTI_ENABLED=false
SELARTI_OUTBOUND_BILLING_MODE=disabled
SELARTI_API_KEY=__PLACEHOLDER_SELARTI_API_KEY__
SELARTI_COMPANY_ID=__PLACEHOLDER_SELARTI_COMPANY_ID__
SELARTI_TASK_ID=__PLACEHOLDER_SELARTI_TASK_ID__
SELARTI_AI_ID=__PLACEHOLDER_SELARTI_AI_ID__
SELARTI_WEBHOOK_SECRET=__PLACEHOLDER_SELARTI_WEBHOOK_SECRET__

PLANERKA_ENABLED=false
PLANERKA_CREATE_ENABLED=false
PLANERKA_RECOVERY_ENABLED=false
# Set only for a separately reviewed recovery/creation activation:
# PLANERKA_API_KEY=__PLACEHOLDER_SERVER_ONLY_PLANERKA_KEY__
# PLANERKA_ACCOUNT_ID=__PLACEHOLDER_AUTHENTICATED_ACCOUNT_ID__
PLANERKA_API_TOKEN=__PLACEHOLDER_PLANERKA_API_TOKEN__
PLANERKA_BASE_URL=__PLACEHOLDER_CONFIRM_FROM_AUTHENTICATED_API_DOCS__
PLANERKA_WEBHOOK_SECRET=__PLACEHOLDER_PLANERKA_WEBHOOK_SECRET__

TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=__PLACEHOLDER_TELEGRAM_BOT_TOKEN__
# Browser account (HTTPS origin without trailing slash; configured by release owner).
# CLIENT_WEB_ORIGIN=https://example.invalid
# CLIENT_TELEGRAM_LOGIN_BOT_USERNAME=your_client_bot
CLIENT_TELEGRAM_WIDGET_LOGIN_ENABLED=false
TELEGRAM_WEBHOOK_SECRET=__PLACEHOLDER_TELEGRAM_WEBHOOK_SECRET__
TELEGRAM_CALLBACK_HMAC_KEY=__PLACEHOLDER_TELEGRAM_CALLBACK_HMAC_KEY__
# Booking callbacks are independent of new booking/calendar admission and TELEGRAM_ENABLED.
# Keep disabled until the reviewed API/DB callback composition is released.
BOOKING_CALLBACKS_ENABLED=false
# Separate new intent admission, outbound HTTP, and local recovery capabilities.
# Send/admission require BOOKING_CALLBACKS_ENABLED=true and recovery=true.
# Admission also requires CLIENT_MESSAGING_CONSENT_POLICY_VERSION.
# Durable DB control must also permit admission; startup never clears a bot pause.
BOOKING_NOTIFICATION_ADMISSION_ENABLED=false
BOOKING_NOTIFICATION_SEND_ENABLED=false
BOOKING_NOTIFICATION_RECOVERY_ENABLED=false
# Enabled callbacks require a real client bot key (vault-compatible ASCII letters,
# digits, underscore or hyphen), TELEGRAM_BOT_TOKEN and TELEGRAM_WEBHOOK_SECRET.
# Provision separate HMAC and AES-256-GCM secrets via the release secret manager.
# Each key is exactly 32 bytes encoded as canonical unpadded base64url (43 characters).
# BOOKING_CALLBACK_HMAC_KEY=__PLACEHOLDER_SERVER_ONLY_BASE64URL_KEY__
# BOOKING_CALLBACK_VAULT_ACTIVE_KEY_ID=v1
# JSON: 1..8 unique [A-Za-z0-9_-] IDs (1..64 characters), active ID must exist.
# Retain old vault keys while outstanding ciphertext needs them; never log this map.
# BOOKING_CALLBACK_VAULT_KEYS={"v1":"__PLACEHOLDER_SERVER_ONLY_BASE64URL_KEY__"}
TELEGRAM_ADMIN_CHAT_ID=__PLACEHOLDER_TELEGRAM_ADMIN_CHAT_ID__
TELEGRAM_SAFETY_CHAT_ID=__PLACEHOLDER_TELEGRAM_SAFETY_CHAT_ID__

PAYMENTS_ENABLED=false
PAYMENT_PROVIDER=disabled
YOOKASSA_ENABLED=false
YOOKASSA_MODE=
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
YOOKASSA_SECRET_REF=
YOOKASSA_RETURN_URL=
YOOKASSA_RECEIPT_VAT_CODE=
YOOKASSA_RECEIPT_PAYMENT_SUBJECT=
YOOKASSA_RECEIPT_PAYMENT_MODE=
YOOKASSA_RECEIPT_CONTACT_CONSENT_PURPOSE=
YOOKASSA_RECEIPT_CONTACT_POLICY_VERSION=
YOOKASSA_RECOVERY_ENCRYPTION_KEY_REFERENCE=
YOOKASSA_RECOVERY_RETENTION_DAYS=
YOOKASSA_UNBOUND_RECOVERY_ENABLED=false
YOOKASSA_UNBOUND_RECOVERY_WINDOW_HOURS=

LLM_ENABLED=false
LLM_PROVIDER=disabled
LLM_API_KEY=__PLACEHOLDER_LLM_API_KEY__
INTENT_MODEL_ENABLED=false
INTENT_MODEL_API_KEY=__PLACEHOLDER_INTENT_MODEL_API_KEY__

MAKE_PROJECTION_ENABLED=false
MAKE_WEBHOOK_URL=__PLACEHOLDER_MAKE_WEBHOOK_URL__

GOOGLE_SHEETS_PROJECTION_ENABLED=false
GOOGLE_SHEETS_ID=__PLACEHOLDER_GOOGLE_SHEETS_ID__
GOOGLE_APPLICATION_CREDENTIALS=__PLACEHOLDER_LOCAL_CREDENTIAL_FILE_PATH__
# Release B1 remains disabled by default; configure bot scope separately in composition.
CLIENT_TELEGRAM_INGRESS_ENABLED=false
CLIENT_TELEGRAM_NAVIGATION_ENABLED=false
CLIENT_HYBRID_ROUTING_ENABLED=false
SELARTI_COST_ADMISSION_ENABLED=false
CLIENT_TELEGRAM_BOT_KEY=bot-client-placeholder
CLIENT_MESSAGING_CONSENT_POLICY_VERSION=client-messaging-v1
SELARTI_AI_CONSENT_POLICY_VERSION=selarti-ai-v1
# Release B2 capabilities remain independently disabled. The response ingress
# cannot be enabled until an official authenticated Selarti fixture is approved.
SELARTI_RESPONSE_INGRESS_ENABLED=false
SELARTI_RESPONSE_SHARED_SECRET=__PLACEHOLDER_SELARTI_RESPONSE_SHARED_SECRET__
B2_TELEGRAM_DISPATCH_ENABLED=false
B2_SENSITIVE_RETENTION_ENABLED=false
## Separate expert browser/API login. Disabled until mapping/migration review.
EXPERT_SESSION_ENABLED=false
EXPERT_TELEGRAM_BOT_TOKEN=placeholder
EXPERT_TELEGRAM_BOT_KEY=placeholder
EXPERT_WEB_ORIGIN=https://example.invalid
EXPERT_TELEGRAM_LOGIN_BOT_USERNAME=example_bot
EXPERT_TELEGRAM_WIDGET_LOGIN_ENABLED=false
# Purchase-bound receipt capture: dedicated keys, explicit deployment retention.
PAYER_RECEIPT_CAPTURE_ENABLED=false
PAYER_RECEIPT_RETENTION_DAYS=
PAYER_RECEIPT_ACTIVE_KEY_ID=
PAYER_RECEIPT_KEYRING_REF=
PAYER_RECEIPT_KEYS_JSON=

# Separate expert applicant promo ingress; never share assistant/work bot identity.
EXPERT_APPLICANT_ENABLED=false
EXPERT_PROMO_TELEGRAM_BOT_ID=
EXPERT_PROMO_TELEGRAM_BOT_KEY=
EXPERT_PROMO_TELEGRAM_WEBHOOK_SECRET=
