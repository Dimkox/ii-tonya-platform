NODE_ENV=production
DATABASE_URL=postgresql://ii_tonya:<database-password>@db.example.invalid:5432/ii_tonya?sslmode=verify-full
ALLOW_INSECURE_LOCAL_DATABASE=false
MIGRATION_COMPATIBILITY_APPROVED_SHA=<full-approved-commit-sha>
DISPLAY_TIMEZONE=Europe/Moscow
RAW_CONVERSATION_LOGGING=false
MINOR_ONBOARDING_ENABLED=false
EXPERT_REFERRAL_ENABLED=false
EXPERT_RESIDENCY_BILLING_ENABLED=false
EXPERT_TELEGRAM_QUERIES_ENABLED=false
EXPERT_TELEGRAM_FINANCIAL_VIEWS_ENABLED=false
EXPERT_AI_INGRESS_ENABLED=false
EXPERT_TELEGRAM_REFERRAL_ENABLED=false
EXPERT_TELEGRAM_CHECKOUT_ENABLED=false
CLIENT_WAITLIST_ENABLED=false
LIFECYCLE_REMINDERS_ENABLED=false
LIFECYCLE_CHECKUPS_ENABLED=false
LIFECYCLE_FEEDBACK_ENABLED=false
LIFECYCLE_COUPON_NOTICES_ENABLED=false

SELARTI_ENABLED=false
SELARTI_OUTBOUND_BILLING_MODE=disabled
# Legacy, no longer read by the config schema; kept only because the pinned
# release validator (scripts/validate-runtime-env.sh) still checks it.
PLANERKA_ENABLED=false
# Planerka: PLANERKA_CREATE/AVAILABILITY require PLANERKA_RECOVERY_ENABLED=true,
# and recovery requires PLANERKA_API_KEY + PLANERKA_ACCOUNT_ID (positive integer).
PLANERKA_CREATE_ENABLED=false
PLANERKA_AVAILABILITY_ENABLED=false
PLANERKA_RECOVERY_ENABLED=false
# PLANERKA_API_KEY=<planerka-api-key>
# PLANERKA_ACCOUNT_ID=<planerka-account-id>
TELEGRAM_ENABLED=false
PAYMENTS_ENABLED=false
PAYMENT_PROVIDER=disabled
YOOKASSA_ENABLED=false
YOOKASSA_MODE=
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
YOOKASSA_SECRET_REF=
YOOKASSA_RETURN_URL=
YOOKASSA_RECEIPT_VAT_CODE=
YOOKASSA_RECEIPT_PAYMENT_SUBJECT=
YOOKASSA_RECEIPT_PAYMENT_MODE=
YOOKASSA_RECEIPT_CONTACT_CONSENT_PURPOSE=
YOOKASSA_RECEIPT_CONTACT_POLICY_VERSION=
YOOKASSA_RECOVERY_ENCRYPTION_KEY_REFERENCE=
YOOKASSA_RECOVERY_RETENTION_DAYS=
YOOKASSA_UNBOUND_RECOVERY_ENABLED=false
YOOKASSA_UNBOUND_RECOVERY_WINDOW_HOURS=
LLM_ENABLED=false
LLM_PROVIDER=disabled
INTENT_MODEL_ENABLED=false
MAKE_PROJECTION_ENABLED=false
GOOGLE_SHEETS_PROJECTION_ENABLED=false

# ---------------------------------------------------------------------------
# FULL ENABLE PROFILE (client MVP + integrations). Placeholders only.
# Do not uncomment blindly: copy into the real runtime env on the host, replace
# every <...> with the secret from the secret store, and flip the matching
# =false lines above (names must stay unique). Order and dependencies:
# docs/operations/prod-enable-checklist.md
# NOTE: scripts/validate-runtime-env.sh (release mode) still requires several
# of these to be false; the release gate must be updated before a live flip.
# ---------------------------------------------------------------------------
# 1. Client MVP (privacy needs session; booking needs session+catalog+outbox)
# WORKER_OUTBOX_DELIVERY_ENABLED=true
# CLIENT_SESSION_ENABLED=true
# CLIENT_CATALOG_ENABLED=true
# CLIENT_PRIVACY_ENABLED=true
# CLIENT_BOOKING_ENABLED=true
# CLIENT_BOOKING_RESERVE_ENABLED=true
# CLIENT_SESSION_BOOKING_GRANTS_ENABLED=true
# CLIENT_WAITLIST_ENABLED=true
# CLIENT_WEB_ORIGIN=https://<client-web-host>
# CLIENT_TELEGRAM_LOGIN_BOT_USERNAME=<client_login_bot>
# 2. Telegram (bot token + webhook secret, 32+ chars [A-Za-z0-9_-])
# TELEGRAM_ENABLED=true
# TELEGRAM_BOT_TOKEN=<telegram-bot-token>
# TELEGRAM_WEBHOOK_SECRET=<telegram-webhook-secret>
# CLIENT_TELEGRAM_BOT_KEY=<client-telegram-bot-key>
# CLIENT_MESSAGING_CONSENT_POLICY_VERSION=<consent-policy-version>
# B2_TELEGRAM_DISPATCH_ENABLED=true
# TELEGRAM_EGRESS_CONSENT_GATE_ENABLED=true
# 3. Lifecycle / booking notifications (reminders need booking+outbox+bot key+consent)
# LIFECYCLE_REMINDERS_ENABLED=true
# LIFECYCLE_CHECKUPS/FEEDBACK/COUPON_NOTICES stay false: env refuses them (no authority yet)
# 4. Selarti
# SELARTI_ENABLED=true
# SELARTI_API_KEY=<selarti-api-key>
# SELARTI_WEBHOOK_SECRET=<selarti-webhook-secret>
# 5. Payments / YooKassa (direct mode)
# PAYMENTS_ENABLED=true
# PAYMENT_PROVIDER=yookassa
# YOOKASSA_ENABLED=true
# YOOKASSA_MODE=<test|live>
# YOOKASSA_SHOP_ID=<numeric-shop-id>
# YOOKASSA_SECRET_KEY=<yookassa-secret-key>
# YOOKASSA_SECRET_REF=env://YOOKASSA_SECRET_KEY
# YOOKASSA_RETURN_URL=https://ii-tonya.ru/<return-path>
# YOOKASSA_RECEIPT_VAT_CODE=<1-12>
# YOOKASSA_RECEIPT_PAYMENT_SUBJECT=<payment-subject>
# YOOKASSA_RECEIPT_PAYMENT_MODE=<payment-mode>
# 6. Expert
# EXPERT_REFERRAL_ENABLED=true
# EXPERT_REFERRAL_HMAC_KEY_VERSION=<key-version>
# EXPERT_REFERRAL_HMAC_KEY_REF=<key-reference>
# EXPERT_RESIDENCY_BILLING_ENABLED=true
# EXPERT_TELEGRAM_QUERIES_ENABLED=true
# EXPERT_TELEGRAM_FINANCIAL_VIEWS_ENABLED=true
# EXPERT_TELEGRAM_REFERRAL_ENABLED=true
# EXPERT_TELEGRAM_CHECKOUT_ENABLED=true
# EXPERT_AI_INGRESS_ENABLED=true
# 7. Planerka (recovery first, then availability/create)
# PLANERKA_RECOVERY_ENABLED=true
# PLANERKA_API_KEY=<planerka-api-key>
# PLANERKA_ACCOUNT_ID=<planerka-account-id>
# PLANERKA_AVAILABILITY_ENABLED=true
# PLANERKA_CREATE_ENABLED=true
