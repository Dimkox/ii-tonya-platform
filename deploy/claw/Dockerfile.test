# syntax=docker/dockerfile:1.7
ARG DOCKER_CLI_IMAGE=docker.io/library/docker:29.7-cli@sha256:206ae9cc405101ab0cf97d4b515d21bf6aae961f98f7f9d8de6c111718fef335
ARG NODE_IMAGE=docker.io/library/node:24.18.0-bookworm-slim
FROM ${DOCKER_CLI_IMAGE} AS docker-cli
FROM ${NODE_IMAGE}
ARG II_TONYA_SOURCE_SHA
ENV PNPM_HOME=/workspace/.pnpm \
    DOCKER_CONFIG=/workspace/.docker \
    PATH=/workspace/.pnpm:$PATH \
    TESTCONTAINERS_HOST_OVERRIDE=host.docker.internal \
    TESTCONTAINERS_DOCKER_SOCKET_OVERRIDE=/var/run/docker.sock
RUN apt-get update && apt-get install -y --no-install-recommends \
      ca-certificates git procps proxychains4 && \
    rm -rf /var/lib/apt/lists/* && \
    npm install --global pnpm@11.9.0 && npm cache clean --force
COPY --from=docker-cli /usr/local/bin/docker /usr/local/bin/docker
COPY --from=docker-cli /usr/local/libexec/docker/cli-plugins /usr/local/libexec/docker/cli-plugins
WORKDIR /seed
COPY . .
RUN --mount=type=cache,id=ii-tonya-claw-pnpm-store,target=/pnpm/store,sharing=locked \
    pnpm config set store-dir /pnpm/store && \
    pnpm config set fetch-timeout 300000 && \
    pnpm config set fetch-retries 5 && \
    pnpm config set fetch-retry-mintimeout 10000 && \
    pnpm config set fetch-retry-maxtimeout 120000 && \
    install_ok=0; \
    for attempt in 1 2 3; do \
      if pnpm install --frozen-lockfile; then install_ok=1; break; fi; \
      sleep "$((attempt * 10))"; \
    done; \
    test "$install_ok" = 1 && \
    cp -a --no-preserve=ownership /pnpm/store /seed/.pnpm-store && \
    printf '%s\n' "$II_TONYA_SOURCE_SHA" > /seed/.source-sha && \
    chmod 0555 /seed/scripts/run-claw-container-tests.sh
USER node
ENTRYPOINT ["/seed/scripts/run-claw-container-tests.sh"]
